# ==============================================================================
# .gitignore for VG Digital Falcon Codebase
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Operating System Files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory

# ------------------------------------------------------------------------------
# 2. IDE & Editor Artifacts
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.code-workspace
.idea/
*.iws
*.iml
*.sublime-project
*.sublime-workspace
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# ------------------------------------------------------------------------------
# 3. Environment & Sensitive Credentials (DO NOT COMMIT SECRETS)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
*.env.*
!.env.example
!.env.sample
!.env.template

# WordPress Sensitive Database Credentials
**/wp-config*.php
!**/wp-config-sample.php

# CRM / App Sensitive Database Configurations (keep samples tracked)
**/client/client/config.php
**/client/client2/config.php
!**/config.sample.php
!**/config.example.php

# ------------------------------------------------------------------------------
# 4. Dependency Directories & Package Managers
# ------------------------------------------------------------------------------
node_modules/
jspm_packages/
.pnpm-store/
vendor/
composer.phar

# ------------------------------------------------------------------------------
# 5. Logs & Diagnostics
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
error_log
debug.log

# ------------------------------------------------------------------------------
# 6. Temporary, Cache & Backup Files
# ------------------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.swp
*.swo
*.orig
*~
.cache/
.parcel-cache/
.turbo/
.sass-cache/

# ------------------------------------------------------------------------------
# 7. Archives, Backups & Dumps
# ------------------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.bak.sql
*.sql.gz
*.sql.tar

